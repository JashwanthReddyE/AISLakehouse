# Copy to .env and fill in. .env is gitignored — never commit real keys.

# AISStream.io free API key (GitHub sign-in at https://aisstream.io)
AISSTREAM_API_KEY=your_api_key here

# Event Hubs connection string with Send claim (from `az eventhubs eventhub authorization-rule keys list`)
# Format: Endpoint=sb://<ns>.servicebus.windows.net/;SharedAccessKeyName=...;SharedAccessKey=...;EntityPath=ais-raw
EVENTHUB_CONNECTION_STRING=your-eventhub-send-connection-string

# Event hub (topic) name — must match infra/main.bicep
EVENTHUB_NAME=ais-raw

# Bounding box for the subscription: minLat,minLon,maxLat,maxLon
# Default below is the Singapore Strait (busy, well-covered, tight for behavior analytics).
AIS_BBOX=1.05,103.5,1.45,104.1

# Ingestion tunables
IDLE_TIMEOUT_S=30
BACKOFF_MAX_S=60
